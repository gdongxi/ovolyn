# The host you pointed at this server. Caddy gets a certificate for it and
# the seed services are published under https://<domain>/stall/<id>.
OVOLYN_DOMAIN=ovolyn.example.com

# Who may move money. Everyone can read; only these accounts can spend.
# Wallet addresses or emails, comma-separated.
OPERATOR_ALLOWLIST=0xyour_wallet_address

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Circle developer-controlled wallets — the treasury and the Sepolia source.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
ORCH_WALLET_ID=
ORCH_ADDRESS=
SEPOLIA_WALLET_ID=
SEPOLIA_ADDRESS=

# App Kit (Swap). Free from the Circle console.
KIT_KEY=

# The model behind the autonomous agent. OpenAI-compatible.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
